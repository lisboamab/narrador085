#!/usr/bin/env bash
# Atalho: ./narrar gerar posts/  ==  .venv/bin/python narrar.py gerar posts/
DIR="$(cd "$(dirname "$0")" && pwd)"
if [ ! -x "$DIR/.venv/bin/python" ]; then
    echo "Ambiente não instalado. Rode primeiro: ./instalar.sh" >&2
    exit 1
fi
exec "$DIR/.venv/bin/python" "$DIR/narrar.py" "$@"
